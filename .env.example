# Environment Configuration for Ownly Workspace

# WebSocket server URL for external JSON document sync
# Development
VITE_WEBSOCKET_URL=ws://localhost:3001

# Production - replace with your deployed Cloudflare Worker URL
# VITE_WEBSOCKET_URL=wss://ownly-websocket.your-account.workers.dev

# NDN testbed configuration (optional)
# VITE_NDN_TESTBED_URL=

# Application version (auto-generated during build)
# VITE_APP_VERSION=

# Debug mode
VITE_DEBUG=false